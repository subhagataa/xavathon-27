---
import BaseLayout from "../layouts/BaseLayout.astro";
import InstagramFeed from "../components/InstagramFeed.astro";
import { albums } from "../data/xavathon";

const upcoming = albums.filter((a) => a.comingSoon);

/* The 8 photos for this page. Filenames map 1:1 to files under
   public/images/gallery/ — add a caption here if you want one to
   show, or leave it blank. */
const photos = [
  { src: "/images/gallery/race-01.jpg", alt: "Xavathon 2026 — race day" },
  { src: "/images/gallery/race-02.jpg", alt: "Xavathon 2026 — race day" },
  { src: "/images/gallery/race-03.jpg", alt: "Xavathon 2026 — race day" },
  { src: "/images/gallery/race-04.jpg", alt: "Xavathon 2026 — race day" },
  { src: "/images/gallery/race-05.jpg", alt: "Xavathon 2026 — race day" },
  { src: "/images/gallery/race-06.jpg", alt: "Xavathon 2026 — race day" },
  { src: "/images/gallery/race-07.jpg", alt: "Xavathon 2026 — race day" },
  { src: "/images/gallery/race-08.jpg", alt: "Xavathon 2026 — race day" },
];
---

<BaseLayout
  title="Gallery | Xavathon 2027"
  description="Photographs from Xavathon 2026 — race day, runners, volunteers, behind the scenes, awards and campus — with the 2027 album to come."
>
  <!-- Page head -->
  <section class="bg-deep py-16 text-chalk sm:py-20">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <h1 class="font-display text-4xl font-bold leading-tight sm:text-6xl">Gallery 2026</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-mist/85">
        The first edition, in the order the morning happened: a dark road, a lot of people on it,
        and a course swept clean by nine.
      </p>
    </div>
  </section>

  <!-- Single line -->
  <div class="bg-deep py-3">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="border-t border-mist/20"></div>
    </div>
  </div>

  <!-- Photos — one flat grid, no albums or categories -->
  <section class="bg-deep py-16 text-chalk sm:py-20">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">

      <div class="mt-5 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {photos.map((p) => (
          <div class="aspect-[4/3] overflow-hidden border border-mist/20 bg-mist/10">
            <img src={p.src} alt={p.alt} class="h-full w-full object-cover" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Coming soon -->
  {upcoming.map((a) => (
    <>
    <!-- Single line -->
    <div class="bg-deep py-3">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
        <div class="border-t border-mist/20"></div>
      </div>
    </div>

    <section class="bg-deep pb-16 text-chalk sm:pb-20">
      <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
        <div class="xv-reveal border-2 border-dashed border-mist/25 px-8 py-14 text-center">
          <p class="font-display text-sm font-semibold text-brass">Coming soon</p>
          <h2 class="font-display mt-3 text-3xl font-bold text-chalk sm:text-4xl">{a.title}</h2>
          <p class="mx-auto mt-3 max-w-[48ch] leading-relaxed text-mist/80">{a.blurb}</p>
          
          <a 
             href="/register"
            class="mt-7 inline-block bg-brass px-7 py-3 font-display font-semibold text-deep transition-colors hover:bg-chalk"
          >
            Be in them - Register
          </a>
        </div>
      </div>
    </section>
    </>
  ))}

  <!-- Single line -->
  <div class="bg-deep py-3">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="border-t border-mist/20"></div>
    </div>
  </div>

</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import RouteDivider from "../components/RouteDivider.astro";
import {
  bibInfo,
  bring,
  wear,
  leaveHome,
  checklist,
  etiquette,
  hydrationGuidance,
  safety,
  transport,
  facilitiesGuide,
  contacts,
  eventEmail,
} from "../data/xavathon";

const sections = [
  { id: "bib", label: "Bib" },
  { id: "kit", label: "What to bring" },
  { id: "checklist", label: "Checklist" },
  { id: "etiquette", label: "Etiquette" },
  { id: "hydration", label: "Hydration" },
  { id: "safety", label: "Safety" },
  { id: "transport", label: "Getting there" },
  { id: "facilities", label: "Facilities" },
];

const lists = [
  { head: "Bring with you", items: bring, tone: "yes" },
  { head: "Wear", items: wear, tone: "yes" },
  { head: "Leave at home", items: leaveHome, tone: "no" },
];
---

<BaseLayout
  title="Participant guide | Xavathon 2027"
  description="Everything a Xavathon 2027 runner needs: bib information, what to bring and wear, a race-day checklist, running etiquette, hydration, safety, transport, parking and bag drop."
>
  <section class="bg-deep py-16 text-chalk sm:py-20">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <h1 class="font-display text-4xl font-bold leading-tight sm:text-6xl">Participant guide</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-mist/85">
        Read this the week before, not the night before. Most of what goes wrong on race morning
        was decided three days earlier.
      </p>
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Sections">
        {sections.map((s) => (
          <a
            href={`#${s.id}`}
            class="border border-mist/35 px-4 py-2 text-sm transition-colors hover:bg-mist/10"
          >
            {s.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <!-- Bib -->
  <section id="bib" class="scroll-mt-20 bg-chalk py-20 sm:py-24">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
        <div class="xv-reveal">
          <SectionHead title="Your bib" />
          <div class="mt-6 space-y-4">
            {bibInfo.map((p) => <p class="max-w-[60ch] leading-relaxed text-slate">{p}</p>)}
          </div>
        </div>

        <!-- A bib, drawn -->
        <div class="xv-reveal self-center">
          <div class="mx-auto max-w-sm border-2 border-deep bg-white p-6 text-center shadow-sm">
            <p class="font-display text-xs font-semibold text-teal">Xavathon 2027 · 10 KM</p>
            <p class="font-display mt-2 text-6xl font-bold leading-none text-deep tabular-nums">1042</p>
            <p class="mt-2 text-xs text-slate">Pen B · Towards Greener Footprints</p>
            <div class="mt-5 flex items-center justify-between border-t border-dashed border-deep/25 pt-3 text-[11px] text-slate">
              <span>Timing chip on the reverse</span>
            </div>
          </div>
          <p class="mt-3 text-center text-xs text-slate">Four pins, four corners, front of the shirt.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Kit -->
  <section id="kit" class="scroll-mt-20 bg-mist/25 py-20 sm:py-24">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <SectionHead title="What to bring, what to wear" />
      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {lists.map((l) => (
          <div class="xv-reveal border border-teal/20 bg-white p-7">
            <h3 class="font-display text-lg font-bold text-deep">{l.head}</h3>
            <ul class="mt-4 space-y-2.5">
              {l.items.map((i) => (
                <li class="flex gap-3 text-sm leading-relaxed text-slate">
                  <span class={`mt-1 shrink-0 ${l.tone === "no" ? "text-slate/50" : "text-teal"}`}>
                    <svg viewBox="0 0 12 12" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2">
                      {l.tone === "no" ? (
                        <path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke-linecap="round" />
                      ) : (
                        <path d="M2 6.4l2.6 2.6L10 3.4" stroke-linecap="round" stroke-linejoin="round" />
                      )}
                    </svg>
                  </span>
                  {i}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Checklist -->
  <section id="checklist" class="scroll-mt-20 bg-deep py-20 text-chalk sm:py-24">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[1fr_1.2fr] lg:gap-16">
        <div class="xv-reveal">
          <SectionHead
            tone="dark"
            title="The night before"
            intro="Seven things. Do them all and race morning is dull, which is exactly what you want."
          />
        </div>
        <ol class="xv-reveal divide-y divide-mist/15 self-center border-y border-mist/15">
          {checklist.map((c, i) => (
            <li class="flex items-baseline gap-4 py-3.5">
              <span class="font-display w-5 shrink-0 font-bold text-brass tabular-nums">{i + 1}</span>
              <span class="text-mist/85">{c}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Etiquette -->
  <section id="etiquette" class="scroll-mt-20 bg-chalk py-20 sm:py-24">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <SectionHead
        title="Running etiquette"
        intro="Three thousand people on one road works only if everybody does the same small things."
      />
      <div class="mt-10 overflow-hidden border border-teal/20">
        <div class="grid grid-cols-2 gap-px bg-teal/20">
          <p class="bg-mist/40 px-6 py-3 font-display text-sm font-semibold text-deep">Do</p>
          <p class="bg-mist/40 px-6 py-3 font-display text-sm font-semibold text-slate">Don't</p>
          {etiquette.map((e) => (
            <>
              <p class="bg-white px-6 py-4 text-sm leading-relaxed text-deep">{e.do}</p>
              <p class="bg-white px-6 py-4 text-sm leading-relaxed text-slate">{e.dont}</p>
            </>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Hydration & safety -->
  <section class="bg-mist/25 py-20 sm:py-24">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
        <div id="hydration" class="xv-reveal scroll-mt-20">
          <h2 class="font-display text-2xl font-bold text-deep">Hydration</h2>
          <ul class="mt-5 space-y-3 border-t border-teal/20 pt-5">
            {hydrationGuidance.map((h) => (
              <li class="flex gap-3 text-sm leading-relaxed text-slate">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-teal/60"></span>
                {h}
              </li>
            ))}
          </ul>
        </div>

        <div id="safety" class="xv-reveal scroll-mt-20">
          <h2 class="font-display text-2xl font-bold text-deep">Safety</h2>
          <ul class="mt-5 space-y-3 border-t border-teal/20 pt-5">
            {safety.map((s) => (
              <li class="flex gap-3 text-sm leading-relaxed text-slate">
                <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-brass"></span>
                {s}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Transport -->
  <section id="transport" class="scroll-mt-20 bg-chalk py-20 sm:py-24">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <SectionHead title="Getting there and getting home" />
      <div class="mt-10 grid gap-px overflow-hidden border border-teal/20 bg-teal/20 sm:grid-cols-2">
        {transport.map((t) => (
          <div class="bg-white p-7">
            <h3 class="font-display text-lg font-semibold text-deep">{t.head}</h3>
            <p class="mt-2 max-w-[48ch] leading-relaxed text-slate">{t.body}</p>
            {t.provisional && (
              <p class="mt-3 inline-block border border-brass/60 bg-brass/10 px-2.5 py-1 text-[11px] text-deep">
                To be confirmed
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Facilities + emergency -->
  <section id="facilities" class="scroll-mt-20 bg-deep py-20 text-chalk sm:py-24">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="grid gap-10 lg:grid-cols-[1.3fr_1fr] lg:gap-14">
        <div class="xv-reveal">
          <SectionHead tone="dark" title="Bag drop, changing and water" />
          <dl class="mt-8 divide-y divide-mist/15 border-y border-mist/15">
            {facilitiesGuide.map((f) => (
              <div class="py-4 sm:grid sm:grid-cols-[11rem_1fr] sm:gap-6">
                <dt class="font-display font-semibold text-brass">{f.head}</dt>
                <dd class="mt-1 max-w-[52ch] text-sm leading-relaxed text-mist/85 sm:mt-0">{f.body}</dd>
              </div>
            ))}
          </dl>
        </div>

        <div class="xv-reveal self-start border border-mist/25 bg-mist/10 p-7">
          <h3 class="font-display text-lg font-bold">Emergency contacts</h3>
          <p class="mt-2 text-sm text-mist/70">
            Save one of these to your phone before race day, and write your own emergency contact on
            the back of your bib.
          </p>
          <ul class="mt-5 divide-y divide-mist/15 border-y border-mist/15">
            {contacts.slice(0, 3).map((c) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
                <span>
                  <span class="font-display font-semibold">{c.name}</span>
                  <span class="ml-2 text-xs text-mist/60">{c.role}</span>
                </span>
                <a href={`tel:${c.phone.replace(/\s/g, "")}`} class="text-sm text-mist/85 hover:text-brass">
                  {c.phone}
                </a>
              </li>
            ))}
          </ul>
          <a href={`mailto:${eventEmail}`} class="mt-4 inline-block text-sm text-brass underline underline-offset-4">
            {eventEmail}
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import { event, timeline, raceDayNotes, emergencyOnDay } from "../data/xavathon";

const tagColour: Record<string, string> = {
  "10 KM": "text-brass border-brass/70",
  "5 KM": "text-mist border-mist/60",
  "3 KM": "text-mist border-mist/60",
  All: "text-mist/70 border-mist/50",
  Everyone: "text-mist/70 border-mist/50",
  Crew: "text-mist/50 border-mist/45",
};

// --- Winding "road" timeline geometry (large screens only; see the plain list fallback below lg) ---
const rowHeight = 260; // px allotted per stop, sets the track's total height
const trackHeight = Math.max(timeline.length, 1) * rowHeight;

// Dots snake left → centre → right → centre as they go down the page.
const xStops = [18, 50, 82];
const roadPoints = timeline.map((_, i) => {
  const x = xStops[i % xStops.length];
  const y = timeline.length > 1 ? 6 + (i * 88) / (timeline.length - 1) : 50;
  const anchor = x <= 25 ? "left" : x >= 75 ? "right" : "center";
  const side = i === timeline.length - 1 ? "below" : "above";
  const translateX = anchor === "left" ? "0%" : anchor === "right" ? "-100%" : "-50%";
  const translateY = side === "above" ? "-100%" : "0%";
  const boxTop = side === "above" ? `calc(${y}% - 14px)` : `calc(${y}% + 14px)`;
  return { x, y, translateX, translateY, boxTop };
});

// Smooth S-bend between each pair of stops (same technique as a rounded step-line chart).
let roadPath = "";
if (roadPoints.length > 0) {
  roadPath = `M ${roadPoints[0].x} ${roadPoints[0].y}`;
  for (let i = 1; i < roadPoints.length; i++) {
    const prev = roadPoints[i - 1];
    const curr = roadPoints[i];
    const midY = prev.y + (curr.y - prev.y) / 2;
    roadPath += ` C ${prev.x} ${midY}, ${curr.x} ${midY}, ${curr.x} ${curr.y}`;
  }
}
---

<BaseLayout
  title="Event day — the race-day timeline | Xavathon 2027"
  description="The Xavathon 2027 race-day timeline: reporting, bib collection, warm-up, flag-off times, hydration, medical cover, the finish line, medals and prize distribution."
>
  <section class="bg-deep py-16 text-chalk sm:py-20">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <h1 class="font-display text-4xl font-bold leading-tight sm:text-6xl">Event day</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-mist/85">
        {event.dateLabel}, from gates open to the last barricade coming down. Times are firm —
        the flag-off will not wait, and the pens close fifteen minutes before it.
      </p>
    </div>
  </section>

  <!-- Double line -->
  <div class="space-y-2 bg-deep py-3">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="border-t border-mist/20"></div>
    </div>
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="border-t border-mist/20"></div>
    </div>
  </div>

  <!-- Bib collection -->
  <section class="bg-deep py-14">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="xv-reveal border border-teal/45 px-7 py-6">
        <div class="max-w-[52ch]">
          <h2 class="font-display text-xl font-bold text-chalk">Collect your bib before race day</h2>
          <p class="mt-2 leading-relaxed text-mist/80">
            The bib desk runs on the two days before the race, on the college campus at 30 Mother
            Teresa Sarani. Carry a photo ID and your registration confirmation. Nothing is handed
            out at the start line on race morning.
          </p>
        </div>
        <p class="mt-5 border-t border-brass/55 pt-4 text-[11px] text-brass">
          Collection dates and hours to be confirmed
        </p>
      </div>
    </div>
  </section>

  <!-- Single line -->
  <div class="bg-deep py-3">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="border-t border-mist/20"></div>
    </div>
  </div>

  <!-- Timeline -->
  <section class="bg-deep py-20 text-chalk sm:py-24">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <SectionHead
        tone="dark"
        title="The morning, in order"
        intro="Find your distance in the right-hand column and work down from there."
      />

      <!-- Small/medium screens: a plain vertical list -->
      <ol class="mt-12 border-l-2 border-mist/55 pl-6 sm:pl-10 lg:hidden">
        {timeline.map((t) => (
          <li class="xv-reveal relative pb-9 last:pb-0">
            <span
              class="absolute -left-[1.85rem] top-1.5 h-3 w-3 rounded-full bg-brass ring-4 ring-deep sm:-left-[2.85rem]"
              aria-hidden="true"
            ></span>
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
              <p class="font-display text-xl font-bold text-chalk tabular-nums">{t.time}</p>
              <p class="font-display text-lg font-semibold text-brass">{t.head}</p>
              <span
                class={`ml-auto border px-3 py-1 text-[11px] ${tagColour[t.tag] ?? "border-mist/50 text-mist/70"}`}
              >
                {t.tag}
              </span>
            </div>
            <p class="mt-2 max-w-[62ch] leading-relaxed text-mist/80">{t.body}</p>
          </li>
        ))}
      </ol>

      <!-- Large screens: a winding road, dot per stop, dashed line snaking between them -->
      <div class="relative mt-16 hidden lg:block" style={`height:${trackHeight}px`}>
        <svg
          class="absolute inset-0 h-full w-full"
          viewBox="0 0 100 100"
          preserveAspectRatio="none"
          aria-hidden="true"
        >
          <path
            d={roadPath}
            class="fill-none stroke-mist/70"
            stroke-width="0.55"
            stroke-dasharray="2 2.6"
            stroke-linecap="round"
          ></path>
        </svg>

        {timeline.map((t, i) => {
          const p = roadPoints[i];
          return (
            <div>
              <div
                class="absolute z-10"
                style={`left:${p.x}%; top:${p.y}%; transform:translate(-50%,-50%);`}
                aria-hidden="true"
              >
                <span class="flex h-7 w-7 items-center justify-center rounded-full border-2 border-brass bg-deep">
                  <span class="h-2.5 w-2.5 rounded-full bg-brass"></span>
                </span>
              </div>
              <div
                class="xv-reveal absolute w-[320px] max-w-[34vw] border border-mist/50 bg-deep px-5 py-4"
                style={`left:${p.x}%; top:${p.boxTop}; transform:translate(${p.translateX}, ${p.translateY});`}
              >
                <div class="flex items-baseline justify-between gap-3 border-b border-mist/45 pb-2">
                  <p class="font-display text-base font-bold text-chalk tabular-nums">{t.time}</p>
                  <span
                    class={`border px-2.5 py-0.5 text-[10px] ${tagColour[t.tag] ?? "border-mist/50 text-mist/70"}`}
                  >
                    {t.tag}
                  </span>
                </div>
                <p class="mt-2 font-display text-sm font-semibold text-brass">{t.head}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-mist/80">{t.body}</p>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Single line -->
  <div class="bg-deep py-3">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="border-t border-mist/20"></div>
    </div>
  </div>

  <!-- On-course notes -->
  <section class="bg-white py-20 sm:py-24">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <SectionHead title="On the course and at the finish" />
      <div class="mt-10 grid gap-px border border-teal/40 bg-teal/35 sm:grid-cols-2">
        {raceDayNotes.map((n) => (
          <div class="bg-white p-7">
            <h3 class="border-b border-teal/40 pb-2 font-display text-lg font-semibold text-deep">{n.head}</h3>
            <p class="mt-3 max-w-[48ch] leading-relaxed text-slate">{n.body}</p>
          </div>
        ))}
      </div>

      <!-- Prize distribution + help desk -->
      <div class="mt-8 grid gap-5 lg:grid-cols-[1.3fr_1fr]">
        <div class="xv-reveal border border-mist/45 bg-deep p-7 text-chalk sm:p-8">
          <h3 class="border-b border-mist/45 pb-3 font-display text-xl font-bold">Prize distribution, 9:00 AM</h3>
          <p class="mt-4 max-w-[56ch] leading-relaxed text-mist/85">
            Podiums for each distance, then age-group winners, then the special awards — including
            the Greenest Footprint, which is the only one where your time counts for nothing.
            Winners should stay on site; prizes are not couriered afterwards.
          </p>
          <a href="/awards" class="mt-5 block border-t border-mist/45 pt-4 font-display font-semibold text-brass underline underline-offset-4">
            What is being awarded
          </a>
        </div>

        <div class="xv-reveal border border-teal/40 p-7">
          <h3 class="border-b border-teal/40 pb-3 font-display text-lg font-bold text-deep">If you need help on the day</h3>
          <dl class="mt-4 divide-y divide-teal/35 border-y border-teal/35">
            {emergencyOnDay.map((e) => (
              <div class="py-3">
                <dt class="font-display text-sm font-semibold text-teal">{e.name}</dt>
                <dd class="mt-0.5 text-sm text-slate">{e.detail}</dd>
              </div>
            ))}
          </dl>
          <a
            href="/participant-guide#safety"
            class="mt-4 block border-t border-teal/40 pt-3 font-display text-sm font-semibold text-teal underline underline-offset-4"
          >
            Safety information
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Single line -->
  <div class="bg-deep py-3">
    <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
      <div class="border-t border-mist/20"></div>
    </div>
  </div>
</BaseLayout>
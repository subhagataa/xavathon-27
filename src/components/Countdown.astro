---
import { event } from "../data/xavathon";

interface Props { tone?: "light" | "dark" }
const { tone = "dark" } = Astro.props;

/* Rendered on the server so the numbers are correct before any
   script runs; the script only keeps them moving. */
const diff = Math.max(0, new Date(event.date).getTime() - Date.now());
const initial = {
  days: Math.floor(diff / 86400000),
  hours: Math.floor(diff / 3600000) % 24,
  mins: Math.floor(diff / 60000) % 60,
  secs: Math.floor(diff / 1000) % 60,
};
const units = [
  { key: "days", label: "days", value: initial.days },
  { key: "hours", label: "hours", value: initial.hours },
  { key: "mins", label: "minutes", value: initial.mins },
  { key: "secs", label: "seconds", value: initial.secs },
];

const box =
  tone === "dark"
    ? "border-white/25 bg-gradient-to-b from-white/15 to-white/0 text-chalk"
    : "border-teal/20 bg-gradient-to-b from-teal/5 to-white text-deep";
const cap = tone === "dark" ? "text-mist/65" : "text-slate";
const colon = tone === "dark" ? "text-white" : "text-deep";
---

<div
  class="xv-countdown flex items-start gap-1.5 sm:gap-2.5"
  data-target={event.date}
  role="timer"
  aria-label={`Time remaining until ${event.dateLabel}`}
>
  {units.map((u, i) => (
    <>
      <div
        class={`xv-cd-box relative flex-1 overflow-hidden rounded-2xl border px-2 py-3 text-center backdrop-blur-sm sm:px-4 sm:py-4 ${box}`}
      >
        <!-- glow wash sitting behind the digits -->
        <span class="xv-cd-glow pointer-events-none absolute inset-0 rounded-2xl" aria-hidden="true"></span>
        <span
          data-unit={u.key}
          class="xv-cd-digit relative block font-display text-2xl font-bold tabular-nums text-current sm:text-4xl"
        >
          {String(u.value).padStart(2, "0")}
        </span>
        <span class={`relative mt-1 block text-[11px] sm:text-xs ${cap}`}>{u.label}</span>
      </div>

      {i < units.length - 1 && (
        <span
          aria-hidden="true"
          class={`xv-cd-colon self-start pt-2 font-display text-2xl font-bold sm:pt-3 sm:text-4xl ${colon}`}
        >
          :
        </span>
      )}
    </>
  ))}
</div>

<style>
  .xv-cd-box {
    --xv-glow-45: rgba(255, 255, 255, 0.45);
    --xv-glow-55: rgba(255, 255, 255, 0.55);
    --xv-glow-35: rgba(255, 255, 255, 0.35);
    --xv-glow-75: rgba(255, 255, 255, 0.75);
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0),
      0 0 24px -6px var(--xv-glow-55),
      0 0 2px 0 var(--xv-glow-35) inset;
    animation: xv-cd-pulse 3.2s ease-in-out infinite;
  }

  .xv-cd-glow {
    background: radial-gradient(circle at 50% 20%, rgba(255, 255, 255, 0.22), transparent 70%);
  }

  .xv-cd-digit {
    text-shadow:
      0 0 16px rgba(255, 255, 255, 0.7),
      0 0 2px rgba(255, 255, 255, 0.9);
  }

  .xv-cd-colon {
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.7);
    animation: xv-cd-blink 1.6s steps(1, end) infinite;
  }

  @keyframes xv-cd-pulse {
    0%,
    100% {
      box-shadow:
        0 0 24px -6px var(--xv-glow-25),
        0 0 2px 0 var(--xv-glow-15) inset;
    }
    50% {
      box-shadow:
        0 0 34px -4px var(--xv-glow-35),
        0 0 3px 0 var(--xv-glow-25) inset;
    }
  }

  @keyframes xv-cd-blink {
    0%,
    45% {
      opacity: 1;
    }
    50%,
    95% {
      opacity: 0.35;
    }
    100% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .xv-cd-box,
    .xv-cd-colon {
      animation: none;
    }
  }
</style>

<script>
  for (const el of document.querySelectorAll(".xv-countdown")) {
    const target = new Date(el.getAttribute("data-target")).getTime();
    const out = {
      days: el.querySelector('[data-unit="days"]'),
      hours: el.querySelector('[data-unit="hours"]'),
      mins: el.querySelector('[data-unit="mins"]'),
      secs: el.querySelector('[data-unit="secs"]'),
    };
    const pad = (n) => String(n).padStart(2, "0");

    const tick = () => {
      const d = Math.max(0, target - Date.now());
      out.days.textContent = pad(Math.floor(d / 86400000));
      out.hours.textContent = pad(Math.floor(d / 3600000) % 24);
      out.mins.textContent = pad(Math.floor(d / 60000) % 60);
      out.secs.textContent = pad(Math.floor(d / 1000) % 60);
      if (d === 0) clearInterval(id);
    };

    const id = setInterval(tick, 1000);
    tick();
  }
</script>
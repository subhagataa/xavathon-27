---
import { faqGroups, eventEmail } from "../data/xavathon";

let n = 0;
---

<section id="faq" class="bg-chalk">
  <div class="border-b border-teal/15 bg-deep py-16 text-chalk sm:py-20">
    <div class="mx-auto max-w-[80rem] px-5 sm:px-8">
      <p class="font-display text-brass">Before you write in</p>
      <h1 class="font-display mt-3 text-4xl font-bold leading-tight sm:text-6xl">
        Questions, answered
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-mist/85">
        Everything runners ask between registration and results, in the order they usually come up.
      </p>
    </div>
  </div>

  <div class="mx-auto max-w-[80rem] px-5 sm:px-8">
    {faqGroups.map((g, gi) => (
      <div class={gi > 0 ? "border-t border-teal/15" : ""}>
        <div class="flex items-baseline gap-4 pb-6 pt-14">
          <span class="font-display text-3xl text-mist/40">{String(gi + 1).padStart(2, "0")}</span>
          <h2 class="font-display text-xl font-bold uppercase tracking-wide text-deep">{g.group}</h2>
        </div>

        <div>
          {g.items.map((item) => {
            n += 1;
            return (
              <details class="xv-faq group border-t border-teal/15 py-1 last:border-b">
                <summary class="flex cursor-pointer list-none items-start gap-5 py-5">
                  <span class="font-display shrink-0 text-sm text-brass">
                    Q{String(n).padStart(2, "0")}
                  </span>
                  <span class="flex-1 text-base font-semibold leading-snug text-deep transition-colors group-hover:text-teal sm:text-lg">
                    {item.q}
                  </span>
                  <span
                    class="xv-faq-plus mt-1 shrink-0 text-lg text-teal transition-transform duration-300"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <div class="flex gap-5 pb-7 pl-0">
                  <span class="font-display hidden shrink-0 text-sm text-transparent sm:inline">Q{String(n).padStart(2, "0")}</span>
                  <div class="max-w-[62ch]">
                    <p class="leading-relaxed text-slate">{item.a}</p>
                    {item.provisional && (
                      <p class="mt-3 inline-block border border-brass/60 bg-brass/10 px-2.5 py-1 text-[11px] text-deep">
                        Subject to final confirmation
                      </p>
                    )}
                  </div>
                </div>
              </details>
            );
          })}
        </div>
      </div>
    ))}

    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-teal/15 py-12">
      <p class="max-w-md text-slate">
        Don't see your question here? Write to us directly and we'll add it for the next runner
        who asks.
      </p>
      <a
        href={`mailto:${eventEmail}`}
        class="font-display inline-flex shrink-0 items-center bg-teal px-6 py-3 text-sm text-chalk transition-colors hover:bg-deep"
      >
        {eventEmail}
      </a>
    </div>
  </div>
</section>

<style is:global>
  /* Safari still paints the default disclosure triangle without this */
  .xv-faq summary::-webkit-details-marker { display: none; }
  .xv-faq[open] .xv-faq-plus { transform: rotate(45deg); }
</style>
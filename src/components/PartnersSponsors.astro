---
import SectionHead from "./SectionHead.astro";
import { eventEmail } from "../data/xavathon";
---

<section id="sponsors" class="bg-chalk py-20 text-deep sm:py-28">
  <div class="mx-auto max-w-[90rem] px-5 sm:px-8">
    <BaseLayout title="Partners & Sponsors" intro="The organisations behind Xavathon 2026." />

    <!-- One combined image instead of individual logo tiles -->
    <div class="xv-reveal mt-14 border border-teal/20 bg-white p-4 sm:p-8">
      <img
        src="/images/sponsors/partners-wall.png"
        alt="Xavathon 2026 partners and sponsors"
        class="mx-auto max-h-[32rem] w-full object-contain"
      />
    </div>

    <!-- Become a partner -->
    <div id="become-a-partner" class="xv-reveal mt-16 border border-teal/20 p-8 text-center sm:p-12">
      <h3 class="font-display text-2xl font-bold sm:text-3xl">Want to see your logo here?</h3>
      <p class="mx-auto mt-3 max-w-xl leading-relaxed text-slate">
        To become a sponsor of Xavathon 2027, write to us and the team will get back to you with
        tiers and availability.
      </p>
      
      <a href={`mailto:${eventEmail}?subject=Xavathon%202027%20partnership`}
        class="mt-7 inline-flex items-center bg-brass px-7 py-3.5 font-display font-semibold text-deep transition-colors hover:bg-chalk"
      >
        {eventEmail}
      </a>
    </div>
  </div>
</section>
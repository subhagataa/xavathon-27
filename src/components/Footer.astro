---
import { event, eventEmail, registerUrl } from "../data/xavathon";

const columns = [
  {
    head: "The race",
    links: [
      { label: "About Xavathon", href: "/about" },
      { label: "Races", href: "/races" },
      { label: "Route maps", href: "/route" },
      { label: "Awards & categories", href: "/awards" },
    ],
  },
  {
    head: "Before you run",
    links: [
      { label: "Registration", href: "/register" },
      { label: "Event day", href: "/event-day" },
      { label: "Participant guide", href: "/participant-guide" },
      { label: "FAQ", href: "/faq" },
    ],
  },
  {
    head: "More",
    links: [
      { label: "Sponsors", href: "/sponsors" },
      { label: "Gallery", href: "/gallery" },
      { label: "Contact us", href: "/contact" },
    ],
  },
];

const instagramUrl = "https://instagram.com/xavathon"; // replace with the real handle

const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-deep text-mist/70">
  <div class="pointer-events-none absolute inset-0 bg-black/20" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-[90rem] px-5 py-14 sm:px-8 sm:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.3fr_2fr]">
      <div>
        <p class="font-display text-2xl font-bold text-chalk">{event.name}</p>
        <p class="mt-1 text-brass">{event.tagline}</p>
        <p class="mt-5 text-sm leading-relaxed">
          {event.dateLabel} · {event.flagOff}<br />
          {event.venue}<br />
          30, Mother Teresa Sarani, Kolkata 700016
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href={registerUrl}
            class="inline-flex bg-brass px-5 py-2.5 font-display text-sm font-semibold text-deep transition-colors hover:bg-chalk"
          >
            Register for 2027
          </a>
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 text-sm transition-colors hover:text-brass"
          >
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
              <rect x="3" y="3" width="18" height="18" rx="5" />
              <circle cx="12" cy="12" r="4" />
              <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
            </svg>
            Follow us on Instagram
          </a>
        </div>
      </div>

      <div class="grid gap-8 sm:grid-cols-3">
        {columns.map((c) => (
          <div>
            <p class="font-display text-sm font-semibold text-chalk">{c.head}</p>
            <ul class="mt-3 space-y-2 text-sm">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} class="transition-colors hover:text-brass">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 flex flex-wrap items-center justify-between gap-x-8 gap-y-3 border-t border-mist/15 pt-6 text-xs">
      <p>© {year} St. Xavier's College (Autonomous), Kolkata. All rights reserved.</p>
      <p>
        <a href={`mailto:${eventEmail}`} class="hover:text-brass">{eventEmail}</a>
        <span class="mx-2 text-mist/30">|</span>
        <a href="/register#terms" class="hover:text-brass">Terms</a>
      </p>
    </div>
  </div>
</footer>
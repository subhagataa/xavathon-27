---
interface Props {
  title: string;
  intro?: string;
  tone?: "light" | "dark";
  align?: "left" | "center";
  /** Page-level heads render as h1; section heads stay h2. */
  as?: "h1" | "h2";
}
const { title, intro, tone = "light", align = "left", as: Tag = "h2" } = Astro.props;
const head = tone === "dark" ? "text-chalk" : "text-deep";
const sub = tone === "dark" ? "text-mist/80" : "text-slate";
const rule = tone === "dark" ? "bg-brass" : "bg-teal";
---

<div class={`xv-reveal ${align === "center" ? "text-center mx-auto" : ""} max-w-2xl`}>
  <div class={`flex gap-1.5 ${align === "center" ? "justify-center" : ""}`}>
    <span class={`h-1 w-10 rounded-full ${rule}`}></span>
    <span class={`h-1 w-4 rounded-full ${rule} opacity-60`}></span>
    <span class={`h-1 w-2 rounded-full ${rule} opacity-30`}></span>
  </div>
  <Tag class={`font-display mt-5 text-3xl sm:text-4xl lg:text-5xl font-semibold leading-[1.12] ${head}`}>
    {title}
  </Tag>
  {intro && <p class={`mt-4 text-base sm:text-lg leading-relaxed ${sub}`}>{intro}</p>}
</div>
